@page "/Admin/Accounts"
@attribute [Authorize(Policy = Permissions.Roles)]
@inject IDbContextFactory<AppDbContext> DbFactory
<PageTitle>Quản lý tài khoản</PageTitle>
<section class="admin-page">
    <div class="page-heading">
        <h1>Quản lý tài khoản</h1>
        <a href="/Admin/Roles" class="btn btn-outline-dark">Vai trò và phân quyền</a>
    </div>
    <AdminNav />
    <label class="visually-hidden" for="account-search">Tìm tài khoản</label>
    <input id="account-search" @bind="search" @bind:event="oninput" class="form-control mb-4" placeholder="Tên đăng nhập, họ tên hoặc email" />
    <div class="admin-panel table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Tên đăng nhập</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Filtered)
                {
                    <tr>
                        <td>@account.UserName</td>
                        <td>@account.FullName</td>
                        <td>@account.Email</td>
                        <td>@string.Join(", ", accountRoles.GetValueOrDefault(account.Id, []))</td>
                        <td><a href="@("/Admin/AccountEdit?id=" + Uri.EscapeDataString(account.Id))" class="btn btn-sm btn-outline-dark">Sửa quyền / mật khẩu</a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Filtered.Any())
        {
            <p>Không tìm thấy tài khoản phù hợp.</p>
        }
    </div>
</section>

@code
{
    private string search = "";
    private List<ApplicationUser> accounts = [];
    private Dictionary<string, string[]> accountRoles = [];
    private IEnumerable<ApplicationUser> Filtered => accounts.Where(x => string.IsNullOrWhiteSpace(search) || (x.UserName + " " + x.FullName + " " + x.Email).Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        accounts = await db.Users.AsNoTracking().OrderBy(x => x.UserName).ToListAsync();
        var assignments = await (
            from ur in db.UserRoles
            join role in db.Roles on ur.RoleId equals role.Id
            select new
            {
                ur.UserId,
                role.Name
            }

        ).ToListAsync();
        accountRoles = assignments.GroupBy(x => x.UserId).ToDictionary(g => g.Key, g => g.Select(x => x.Name!).ToArray());
    }
}
