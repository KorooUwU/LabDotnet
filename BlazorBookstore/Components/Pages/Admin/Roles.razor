@page "/Admin/Roles"
@attribute [Authorize(Policy=Permissions.Roles)]
@inject IServiceScopeFactory Scopes
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject IAuthorizationService Authorization
<PageTitle>Vai trò và phân quyền</PageTitle>
<section class="admin-page"><h1>Vai trò và phân quyền</h1><AdminNav/>
@if(message is not null){<p class="alert alert-info" role="status">@message</p>}
<form @onsubmit="Create" @onsubmit:preventDefault class="admin-panel admin-toolbar"><label>Tên vai trò<input @bind="newName" required maxlength="50" class="form-control"/></label><button class="btn btn-dark">Tạo vai trò</button></form>
<p>Vai trò quản trị cần Admin.Access cộng thêm quyền của từng chức năng.</p>
@foreach(var role in roleList){<article class="admin-panel my-3"><h2>@role.Name</h2>@foreach(var permission in Permissions.All){<label class="d-block"><input type="checkbox" checked="@roleSelections[role.Id].Contains(permission)" disabled="@(role.Name=="Admin")" @onchange="e=>Toggle(roleSelections[role.Id],permission,e)"/> @permission</label>}<button class="btn btn-dark mt-3" disabled="@(role.Name=="Admin")" @onclick="()=>SavePermissions(role.Id)">Lưu quyền</button></article>}
<h2>Gán vai trò cho tài khoản</h2>
@foreach(var user in accounts){<article class="admin-panel my-3"><strong>@user.UserName — @user.FullName</strong>@foreach(var role in roleList){<label class="d-block"><input type="checkbox" checked="@userSelections[user.Id].Contains(role.Name!)" @onchange="e=>Toggle(userSelections[user.Id],role.Name!,e)"/> @role.Name</label>}<button class="btn btn-dark mt-3" @onclick="()=>SaveUser(user.Id)">Lưu vai trò</button></article>}</section>
@code{
 private string newName="";private string? message;
 private List<IdentityRole> roleList=[];private List<ApplicationUser> accounts=[];
 private Dictionary<string,HashSet<string>> roleSelections=[],userSelections=[];
 protected override async Task OnInitializedAsync()=>await Load();
 private async Task Load(){await using var db=await DbFactory.CreateDbContextAsync();roleList=await db.Roles.AsNoTracking().ToListAsync();accounts=await db.Users.AsNoTracking().ToListAsync();var claims=await db.RoleClaims.AsNoTracking().Where(x=>x.ClaimType=="Permission").ToListAsync();var assignments=await db.UserRoles.AsNoTracking().ToListAsync();roleSelections=roleList.ToDictionary(x=>x.Id,x=>claims.Where(c=>c.RoleId==x.Id).Select(c=>c.ClaimValue!).ToHashSet());userSelections=accounts.ToDictionary(x=>x.Id,x=>assignments.Where(a=>a.UserId==x.Id).Select(a=>roleList.First(r=>r.Id==a.RoleId).Name!).ToHashSet());}
 private static void Toggle(HashSet<string> set,string value,ChangeEventArgs e){if(e.Value is true)set.Add(value);else set.Remove(value);}
 private async Task<bool> Allowed()=> (await Authorization.AuthorizeAsync((await Auth.GetAuthenticationStateAsync()).User,Permissions.Admin)).Succeeded && (await Authorization.AuthorizeAsync((await Auth.GetAuthenticationStateAsync()).User,Permissions.Roles)).Succeeded;
 private async Task Create(){if(!await Allowed()){message="Bạn không có quyền.";return;}if(string.IsNullOrWhiteSpace(newName)||newName.Trim().Length>50){message="Tên vai trò từ 1 đến 50 ký tự.";return;}await using var scope=Scopes.CreateAsyncScope();var roles=scope.ServiceProvider.GetRequiredService<RoleManager<IdentityRole>>();var result=await roles.CreateAsync(new(newName.Trim()));message=result.Succeeded?"Đã tạo vai trò.":string.Join("; ",result.Errors.Select(x=>x.Description));if(result.Succeeded)newName="";await Load();}
 private async Task SavePermissions(string roleId){if(!await Allowed()){message="Bạn không có quyền.";return;}await using var scope=Scopes.CreateAsyncScope();var roles=scope.ServiceProvider.GetRequiredService<RoleManager<IdentityRole>>();var users=scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();var db=scope.ServiceProvider.GetRequiredService<AppDbContext>();var role=await roles.FindByIdAsync(roleId);if(role is null||role.Name=="Admin")return;await using var tx=await db.Database.BeginTransactionAsync();foreach(var claim in (await roles.GetClaimsAsync(role)).Where(x=>x.Type=="Permission"))Check(await roles.RemoveClaimAsync(role,claim));foreach(var p in roleSelections[roleId].Where(Permissions.All.Contains))Check(await roles.AddClaimAsync(role,new("Permission",p)));foreach(var user in await users.GetUsersInRoleAsync(role.Name!))Check(await users.UpdateSecurityStampAsync(user));await tx.CommitAsync();message="Đã cập nhật quyền. Tài khoản bị ảnh hưởng cần đăng nhập lại.";await Load();}
 private async Task SaveUser(string userId){if(!await Allowed()){message="Bạn không có quyền.";return;}await using var scope=Scopes.CreateAsyncScope();var users=scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();var db=scope.ServiceProvider.GetRequiredService<AppDbContext>();var user=await users.FindByIdAsync(userId);if(user is null)return;var selected=userSelections[userId];if(selected.Count==0){message="Chọn ít nhất một vai trò.";return;}var current=await users.GetRolesAsync(user);if(current.Contains("Admin")&&!selected.Contains("Admin")&&(await users.GetUsersInRoleAsync("Admin")).Count<=1){message="Không được bỏ vai trò của quản trị viên cuối cùng.";return;}await using var tx=await db.Database.BeginTransactionAsync();Check(await users.RemoveFromRolesAsync(user,current.Except(selected)));Check(await users.AddToRolesAsync(user,selected.Except(current)));Check(await users.UpdateSecurityStampAsync(user));await tx.CommitAsync();message="Đã gán vai trò. Tài khoản bị ảnh hưởng cần đăng nhập lại.";await Load();}
 private static void Check(IdentityResult result){if(!result.Succeeded)throw new InvalidOperationException(string.Join("; ",result.Errors.Select(x=>x.Description)));}
}

