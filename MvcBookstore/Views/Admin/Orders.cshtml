
@model OrdersModel
@{ViewData["Title"]="Đơn hàng";}
<section class="admin-page"><div class="page-heading"><h1>Quản lý đơn hàng</h1><a class="btn btn-dark" asp-controller="Admin" asp-action="OrderEdit">Thêm đơn hàng</a></div><partial name="_Message" /><form method="get" class="admin-toolbar"><input asp-for="Search" class="form-control" placeholder="Mã đơn, khách hàng, điện thoại, sách" /><select asp-for="Status" class="form-select"><option value="">Tất cả trạng thái</option>@foreach(var s in OrderStatuses.All){<option value="@s.Key">@s.Value</option>}</select><button class="btn btn-dark">Tìm kiếm</button></form><div class="admin-panel table-responsive"><table class="table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày tạo</th><th>Trạng thái</th><th>Tổng tiền</th><th>Thao tác</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>#@x.Id</td><td>@x.Customer.Name</td><td>@x.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@OrderStatuses.All.GetValueOrDefault(x.Status,x.Status)</td><td>@x.Total.ToString("N0")đ</td><td><a class="btn btn-sm btn-outline-dark" asp-controller="Admin" asp-action="OrderEdit" asp-route-id="@x.Id">Sửa</a><form method="post" asp-action="DeleteOrder" class="d-inline" data-confirm="Xóa đơn hàng này?"><input type="hidden" name="id" value="@x.Id" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table>@if(!Model.Items.Any()){<p>Không tìm thấy đơn hàng.</p>}</div></section>

