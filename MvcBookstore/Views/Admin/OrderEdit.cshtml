
@model OrderEditModel
@{ViewData["Title"]="Thông tin đơn hàng";}
<section class="admin-page"><h1>@(Model.Input.Id==0?"Thêm đơn hàng":"Sửa đơn hàng #"+Model.Input.Id)</h1><form method="post" class="admin-panel admin-form"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Input.Id" type="hidden" /><div><label asp-for="Input.CustomerId">Khách hàng</label><select asp-for="Input.CustomerId" class="form-select"><option value="0">Chọn khách hàng</option>@foreach(var c in Model.Customers){<option value="@c.Id">@c.Name — @c.Phone</option>}</select><a href="/Admin/CustomerEdit">Thêm khách hàng mới</a></div><div><label asp-for="Input.Status">Trạng thái</label><select asp-for="Input.Status" class="form-select">@foreach(var s in OrderStatuses.All){<option value="@s.Key">@s.Value</option>}</select></div><div><label asp-for="Input.Address">Địa chỉ giao hàng</label><input asp-for="Input.Address" class="form-control" /></div><div><label asp-for="Input.Note">Ghi chú</label><textarea asp-for="Input.Note" class="form-control"></textarea></div><div class="order-lines"><h2>Sách trong đơn</h2><div class="table-responsive"><table class="table"><thead><tr><th>Sách</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>@for(int i=0;i<Model.Input.Lines.Count;i++){var line=Model.Input.Lines[i];var snapshot=Model.Resolve(line);<tr><td><input asp-for="Input.Lines[i].OriginalLineId" type="hidden" /><input asp-for="Input.Lines[i].ProductId" type="hidden" />@(snapshot?.ProductName??"Sách không còn tồn tại")</td><td>@((snapshot?.UnitPrice??0).ToString("N0"))đ</td><td><input asp-for="Input.Lines[i].Quantity" min="1" max="999" class="form-control" /><span asp-validation-for="Input.Lines[i].Quantity" class="text-danger"></span></td><td>@(((snapshot?.UnitPrice??0)*line.Quantity).ToString("N0"))đ</td><td><button asp-action="OrderRemove" name="index" value="@i" formnovalidate class="btn btn-outline-danger">Bỏ</button></td></tr>}</tbody></table></div><select asp-for="AddProductId" class="form-select"><option value="0">Chọn sách để thêm</option>@foreach(var p in Model.Products){<option value="@p.Id">@p.Name — @p.Price.ToString("N0")đ</option>}</select><button asp-action="OrderAdd" formnovalidate class="btn btn-outline-dark">Thêm sách vào đơn</button><h3>Tổng: @Model.Total.ToString("N0")đ</h3><p>Giá và tên sách của đơn đã lưu được giữ theo thời điểm tạo đơn.</p></div><div class="admin-actions"><button asp-action="OrderSave" class="btn btn-dark">Lưu đơn hàng</button><a href="/Admin/Orders" class="btn btn-outline-dark">Hủy</a></div></form></section>

