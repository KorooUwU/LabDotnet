@{ var current = ViewContext.RouteData.Values["page"]?.ToString() ?? ""; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] - Mộc Books Admin</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body><div class="admin-shell"><aside class="admin-sidebar"><div class="sidebar-brand"><a href="/Admin" class="brand-mark">MỘC<span>.</span></a><button class="sidebar-toggle" type="button" data-menu="admin-menu" aria-controls="admin-menu" aria-expanded="false" aria-label="Mở menu quản trị">☰</button></div><div id="admin-menu" class="sidebar-content"><p class="sidebar-caption">KHÔNG GIAN QUẢN TRỊ</p><nav class="sidebar-links"><a href="/Admin" class="@(current == "/Admin/Index" ? "active" : "")">▦ Tổng quan</a><a href="/Admin/Products" class="@(current.Contains("Product") ? "active" : "")">◇ Quản lý sách</a><a href="/Admin/Customers" class="@(current.Contains("Customer") ? "active" : "")">○ Quản lý khách hàng</a><a href="/Admin/Orders" class="@(current.Contains("Order") ? "active" : "")">▱ Quản lý đơn hàng</a><a href="/Admin/Categories">Quản lý danh mục</a><a href="/Admin/Roles">Vai trò và phân quyền</a></nav><a class="admin-back" href="/">← Về nhà sách</a></div></aside><div class="admin-main"><header class="admin-topbar"><span>MỘC / ADMIN · MVC</span><partial name="_AccountNavbar" /></header><main class="admin-content">@RenderBody()</main></div></div><script src="~/js/razor-site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",false)</body></html>



