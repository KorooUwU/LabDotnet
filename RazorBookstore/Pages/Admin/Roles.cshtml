@page
@model WebApplication1.Pages.Admin.RolesModel
@{ViewData["Title"]="Vai trò và phân quyền";}
<section class="admin-page"><h1>Vai trò và phân quyền</h1><partial name="_Message"/><div asp-validation-summary="All" class="text-danger"></div><form method="post" asp-page-handler="Create" class="admin-panel admin-toolbar"><label>Tên vai trò <input name="name" maxlength="50" required class="form-control"/></label><button class="btn btn-dark">Tạo vai trò</button></form><p>Vai trò quản trị cần quyền Admin.Access để mở khu quản trị, cộng thêm quyền của từng chức năng.</p>@foreach(var role in Model.Roles){<form method="post" asp-page-handler="Permissions" class="admin-panel my-3"><input name="roleId" value="@role.Id" type="hidden"/><h2>@role.Name</h2>@foreach(var permission in Permissions.All){<label class="d-block"><input type="checkbox" name="selected" value="@permission" checked="@(Model.RolePermissions.GetValueOrDefault(role.Id,[]).Contains(permission))" disabled="@(role.Name=="Admin")"/> @permission</label>}<button class="btn btn-dark mt-3" disabled="@(role.Name=="Admin")">Lưu quyền</button></form>}<h2>Gán vai trò cho tài khoản</h2>@foreach(var account in Model.Accounts){<form method="post" asp-page-handler="User" class="admin-panel my-3"><input name="userId" value="@account.Id" type="hidden"/><strong>@account.UserName — @account.FullName</strong>@foreach(var role in Model.Roles){<label class="d-block"><input type="checkbox" name="selectedRoles" value="@role.Name" checked="@(Model.UserRoles.GetValueOrDefault(account.Id,[]).Contains(role.Id))"/> @role.Name</label>}<button class="btn btn-dark mt-3">Lưu vai trò</button></form>}</section>
