@page
@model WebApplication1.Pages.Admin.ProductsModel
@{ViewData["Title"]="Quản lý sách";}
<section class="admin-page"><div class="page-heading"><h1>Quản lý sách</h1><a class="btn btn-dark" asp-page="ProductEdit">Thêm sách</a></div><partial name="_Message" /><form method="get" class="admin-toolbar"><input class="form-control" asp-for="Search" placeholder="Tên sách, tác giả, thể loại, ISBN" /><button class="btn btn-dark">Tìm kiếm</button></form><div class="admin-panel table-responsive"><table class="table"><thead><tr><th>Sách</th><th>Tác giả</th><th>Thể loại</th><th>Giá</th><th>Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><div class="table-product"><partial name="_ProductPhoto" model="item" />@item.Name</div></td><td>@item.Author</td><td>@item.Category</td><td>@item.Price.ToString("N0")đ</td><td><a class="btn btn-sm btn-outline-dark" asp-page="ProductEdit" asp-route-id="@item.Id">Sửa</a><form method="post" asp-page-handler="Delete" data-confirm="Xóa sách này?" class="d-inline"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table>@if(!Model.Items.Any()){<p>Không tìm thấy sách.</p>}</div></section>
