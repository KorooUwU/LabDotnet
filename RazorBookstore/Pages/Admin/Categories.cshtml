@page
@model WebApplication1.Pages.Admin.CategoriesModel
@{ViewData["Title"]="Danh mục";}
<section class="admin-page"><h1>Quản lý danh mục</h1><partial name="_Message"/><form method="get" class="admin-toolbar"><input asp-for="Search" class="form-control" placeholder="Tìm danh mục"/><button class="btn btn-dark">Tìm kiếm</button></form><form method="post" asp-page-handler="Save" class="admin-form admin-panel"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Input.Id" type="hidden"/><div><label asp-for="Input.Name">Tên danh mục</label><input asp-for="Input.Name" class="form-control"/></div><div><label asp-for="Input.Description">Mô tả</label><textarea asp-for="Input.Description" class="form-control"></textarea></div><button class="btn btn-dark">Lưu danh mục</button><a href="/Admin/Categories">Thêm mới / Hủy sửa</a></form><div class="admin-panel table-responsive mt-4"><table class="table"><thead><tr><th>Tên</th><th>Mô tả</th><th>Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>@item.Description</td><td><a asp-page="Categories" asp-route-id="@item.Id">Sửa</a><form method="post" asp-page-handler="Delete" class="d-inline" data-confirm="Xóa danh mục này?"><input name="id" type="hidden" value="@item.Id"/><button class="btn btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table></div></section>
