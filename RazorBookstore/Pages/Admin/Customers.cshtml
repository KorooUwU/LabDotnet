@page
@model WebApplication1.Pages.Admin.CustomersModel
@{ViewData["Title"]="Khách hàng";}
<section class="admin-page"><div class="page-heading"><h1>Quản lý khách hàng</h1><a class="btn btn-dark" asp-page="CustomerEdit">Thêm khách hàng</a></div><partial name="_Message" /><form method="get" class="admin-toolbar"><input class="form-control" asp-for="Search" placeholder="Tên, email, số điện thoại" /><button class="btn btn-dark">Tìm kiếm</button></form><div class="admin-panel table-responsive"><table class="table"><thead><tr><th>Tên</th><th>Email</th><th>Điện thoại</th><th>Địa chỉ</th><th>Thao tác</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>@item.Email</td><td>@item.Phone</td><td>@item.Address</td><td><a class="btn btn-sm btn-outline-dark" asp-page="CustomerEdit" asp-route-id="@item.Id">Sửa</a><form method="post" asp-page-handler="Delete" class="d-inline" data-confirm="Xóa khách hàng này?"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table>@if(!Model.Items.Any()){<p>Không tìm thấy khách hàng.</p>}</div></section>
