@if (User.Identity?.IsAuthenticated == true) {
<div class="account-navbar"><span>Xin chào, <strong>@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</strong></span><form asp-page="/Logout" method="post"><button class="text-link" type="submit">Đăng xuất</button></form></div>
} else { <a asp-page="/Login">Đăng nhập</a> }

